{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PostgreSQL",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "postgres"],
      "problemMatcher": []
    },
    {
      "label": "Run Alembic migrations",
      "type": "shell",
      "command": "..\\.venv\\Scripts\\python.exe",
      "args": ["-m", "alembic", "upgrade", "head"],
      "options": {"cwd": "${workspaceFolder}\\backend"},
      "problemMatcher": []
    },
    {
      "label": "Run Linux Admin Platform API",
      "type": "shell",
      "command": "..\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}\\backend"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview Linux Admin Platform",
      "type": "shell",
      "command": "npm",
      "args": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test backend",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "backend\\tests", "-q"],
      "problemMatcher": []
    },
    {
      "label": "Build frontend",
      "type": "shell",
      "command": "npm",
      "args": ["--prefix", "frontend", "run", "build"],
      "problemMatcher": []
    }
  ]
}
