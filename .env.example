DATABASE_PATH=backend/data/platform.db
CORS_ORIGINS=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-long-private-password
ALLOWED_SERVICES=ssh,cron,systemd-journald
SESSION_TTL_HOURS=12
COLLECTOR_INTERVAL_SECONDS=15
RETENTION_DAYS=30
COLLECTOR_ENABLED=true
CPU_ALERT_THRESHOLD=85
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90
PROTECTED_SERVICES=ssh,systemd-journald
SERVICE_CRITICALITY=ssh:critical,cron:medium,systemd-journald:high
